#ifndef WIFI_CONFIG_H
#define WIFI_CONFIG_H

/* ============================================================
 * WiFi 与上位机地址配置模板
 * 用法：复制本文件为 wifi_config.h 并填入实际值。
 *       wifi_config.h 已在 .gitignore，绝不可提交真实 SSID/密码。
 * ============================================================ */

/* WiFi 名称与密码（ESP8266 仅支持 2.4 GHz） */
#define WIFI_SSID           "YOUR_SSID"
#define WIFI_PASSWORD       "YOUR_PASSWORD"

/* Qt 上位机（PC）的局域网 IP 与 NodeServer 监听端口。
 * 端口必须与 llama-server 的 8092 错开，固定为 9092。 */
#define TCP_SERVER_IP       "192.168.1.100"
#define TCP_SERVER_PORT     9092

#endif /* WIFI_CONFIG_H */
