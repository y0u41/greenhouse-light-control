# ---- Keil MDK 产物与用户态文件 ----
# Output/ 是 Keil 的产物目录（.o/.axf/.hex/.map/.htm/.dep 全在里面）
firmware/Output/
firmware/Projects/MDK-ARM/DebugConfig/
firmware/Projects/MDK-ARM/build.log
# Keil Assistant / VSCode-CppTools 的**本机态**文件：不是工程事实源。
#   · c_cpp_properties.json 内嵌 37 条 `d:\正点原子\...` 绝对路径 + 生成时的
#     DEBUG_UART=1（与发布态 uvprojx 不一致），换机即失效，无协作价值。
#   · uv4.log.lock 是 UV4 退出时残留的 0 字节进程锁。
# 已 git rm --cached；include 路径的真源是 tools/make_keil_project.py 里的 INCLUDE_PATHS。
firmware/Projects/MDK-ARM/.vscode/
*.uvguix.*
*.uvoptx
*.dep
*.lnp
*.htm
*.build_log.htm
*.scvd
JLinkLog.txt
*.iex
*.bak

# ---- 本地密钥与配置（绝不可入仓） ----
firmware/Core/Inc/wifi_config.h
.env

# ---- 运行时数据（历史数据/日志落本地，不入仓） ----
*.csv
*.sqlite
*.db
*.log
__pycache__/
*.pyc

# ---- 系统 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 主机测试产物 ----
tests/host/build/
